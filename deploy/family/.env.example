# OpenTodo для семьи — переменные окружения. Все необязательны; значения по
# умолчанию работают сразу. Docker compose читает файл .env рядом с
# docker-compose.yml — скопируйте и раскомментируйте нужное:
#   cp .env.example .env

# Адрес, по которому люди открывают сервер. Пусто — сервер сам берёт адрес из
# запросов; это нормально для localhost, IP или имени без точки
# (http://localhost:4002, http://192.168.1.20:4002, http://nas:4002).
# Под настоящим доменом задайте его явно: cookies получат флаг Secure, ссылки
# приглашений будут строиться от него, и код установки не понадобится.
# Только origin, без пути: OpenTodo не обслуживается ниже пути вроде
# example.com/todo/ — дайте ему поддомен или свой порт.
#OPENTODO_BASE_URL=https://todo.example.com

# Включить MCP-эндпоинт (/mcp) для ИИ-ассистентов при первом старте
# (по умолчанию true — пресет этого набора). Сам эндпоинт только читает,
# пока владелец не разрешит изменения в «Настройки → Интеграции → AI-ассистенты».
#OPENTODO_MCP=true

# Пресет на первый старт: ассистенты могут вносить изменения (по умолчанию
# выключено; потом включается в настройках, для каждого аккаунта отдельно).
#OPENTODO_MCP_WRITES=true
